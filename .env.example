# =============================================================
# JontroGhor — Environment Variables
# Copy this file to .env and fill in your values.
# =============================================================

# --------------------------------------------------
# Database (Prisma)
# --------------------------------------------------
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL="postgresql://postgres:password@localhost:5432/jontroghor"

# --------------------------------------------------
# Better Auth
# --------------------------------------------------
# Generate a strong secret: openssl rand -base64 32
BETTER_AUTH_SECRET="your-super-secret-key-change-me"
BETTER_AUTH_URL="http://localhost:3000"

# --------------------------------------------------
# Next.js Public Variables (exposed to browser)
# --------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="JontroGhor"

# --------------------------------------------------
# Optional: Email (for notifications)
# --------------------------------------------------
# SMTP_HOST="smtp.example.com"
# SMTP_PORT=587
# SMTP_USER="noreply@jontroghor.com"
# SMTP_PASS="your-email-password"
